# Large CSV files - originals backed up, use split versions
data/originals/*
data/Cascadia_relocated_catalog_picks_ver_3.csv
data/Cascadia_relocated_catalog_picks_with_amplitudes_ver_3.csv
data/Cascadia_relocated_catalog_picks_ver_3_with_amplitudes.csv

# Derived magnitude datasets + figures (regenerated by 4_relocation/magnitude/*.py)
data/magnitude/*.csv
data/magnitude/*.png

# Figure/pipeline input data fetched from the server by ./download_data.sh
# (large; reproducible from the lab server, not committed)
data/datasets_all_regions/
data/datasets_anss/

# Paper build artifacts (main.tex is committed + synced; the rest is regenerated
# by `make paper`). main.pdf is a local preview — Overleaf compiles the shared PDF.
paper/main_body.tex
paper/main.pdf
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.xdv
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/main.synctex.gz
# Staged non-paper data (moved by utils/organize_review_data.py; local review only)
data/_review/

# Assembled Zenodo submission package (built by utils/assemble_zenodo.py; local)
data/zenodo/

# Slab2 reference grid (fetched from ScienceBase; reproducible, not committed)
data/slab2/

# Tomography model (fetched from IRIS EMC; reproducible)
data/tomography/

# Cached GMRT topography grids (fetched by phase5 --gmrt)
data/gmrt/

# Route A amplitude re-run: raw outputs, backups and full StationXML (large;
# archived at /auto/c-wsd01/PNSN_exotic/cascadia_magnitude_routeA_v2)
4_relocation/magnitude/_raw_pre_dedupe/
4_relocation/magnitude/rerun_v2/
4_relocation/magnitude/rerun_v2_backups/
4_relocation/magnitude/raw_wa_amplitudes*.csv
4_relocation/magnitude/station_inventory*.xml

